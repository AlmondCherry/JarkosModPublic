	biomechanical_heart: {
		DisplayName: biomechanical_heart
		Tooltip:
			'''
			It is triggered if the player current health is below 75%,
			Attacks nearby enemies and sucks blood from them.
			The heart pours all the accumulated blood out of itself into the player, and at the same time heals him.
			The heart will disappear as soon as the player has more than 75% health.
			'''
	}

	PhaseBloodShield: {
		Tooltip:
			'''
			Grants the opportunity to make a phaseblood dash, during a jerk
			The owner leaves explosive waves behind when hitting the enemy.
			heals the player. Increases defense by 25 during a dash.
			Also, if the player's health is below 25%, he will have complete invulnerability to damage during the dash.
			'''
		DisplayName: Phase Blood Shield
	}

	HemoStabilizer: {
		Tooltip:
			'''
			When you click on "bind", it takes 25% of your current health, but in return it gives you boost attack speed on 20% for 15 seconds.
			Cooldown is 60 seconds.
			'''
		DisplayName: Hemo Stabilizer
	}

	OverloadCloak: {
		Tooltip:
			'''
			Grants an aura to the owner, the enemies inside of which increase the player's regeneration.
			The maximum increase in health regeneration is up to 10 HP/sec.
			For 1 HP/sec received from an enemy in aura, total damage increases by 1%
			'''
		DisplayName: Mantle of Hypocapnia
	}

	ResonanceBell: {
		Tooltip:
			'''
			When you click on "bind" causes a large bell to ring over the owner's head.
			which creates shock waves, the enemies become resonant
