			Tooltip: Вертикальная позиция интерфейса кузницы в процентах от высоты экрана
		}

		SaveDragPosition: {
			Label: Сохранять позицию после перетаскивания
			Tooltip: Если включено, позиция UI будет сохраняться после перетаскивания
		}

		small_gameplay_changes: {
			Label: Small gameplay changes
			Tooltip: Allows you enable to use unbalanced accessories.
		}

		MoreVanillaLoot: {
			Label: More Vanilla Loot
			Tooltip: When enabled, extra modified mod loot drops from vanilla bosses. When disabled, extra loot will not drop.
		}

		EssenceEffectMultiplier: {
			Label: Essence Effect Multiplier
			Tooltip: Multiplier for essence effect values on rune armor enchantments (from 0.5 to 1.75).
		}

		InductionUIPositionX: {
			Label: UI Position X
			Tooltip: Горизонтальная позиция интерфейса (0.0 - левый край, 1.0 - правый край)
		}

		InductionUIPositionY: {
			Label: UI Position Y
			Tooltip: Вертикальная позиция интерфейса (0.0 - верхний край, 1.0 - нижний край)
		}

		EnableArenaShader: {
			Label: Enable Arena Shader
			Tooltip: Вертикальная позиция интерфейса (0.0 - верхний край, 1.0 - нижний край)
		}

		EnableBossBackground: {
			Label: Enable Boss Background
			Tooltip: Вертикальная позиция интерфейса (0.0 - верхний край, 1.0 - нижний край)
		}

		maxparticles: {
			Label: Max Particles
			Tooltip: Вертикальная позиция интерфейса (0.0 - верхний край, 1.0 - нижний край)
		}

		EnableForceFinish: {
			Label: Force Finish Research Button
			Tooltip: Shows 'Force Finish' button when selecting a node in the research table / Показывает кнопку Force Finish в столе исследований при выборе ноды
		}

		UnlockAllEssences: {
			Label: Unlock All Essences (Infinite / Cheat)
			Tooltip: Gives 99999 of each essence and unlocks all essences while enabled. Restores original amounts and research when disabled.
		}

		TownNPCSpawnMultiplier: {
			Label: Town NPC Arrival Rate / Шанс прихода городских НПС
			Tooltip: Чем больше значение, тем намного выше шанс прихода любых городских НПС при наличии свободного дома. 1 - обычная норма, 0 - выключено.
		}

		DisableResearchBuffs: {
			Label: Отключить усиления от исследований
			Tooltip: При включении все исследованные узлы, дающие игроку баффы и эффекты, отключаются. При этом исследованные ритуалы в книге остаются доступными.
		}

		DaylightAlwaysWorks: {
			Label: Дневная станция и генератор работают всегда
			Tooltip: При включении этой настройки Дневная станция и Дневной генератор вырабатывают эссенции независимо от времени суток (и днём, и ночью).
		}

		ScavengerPriceMultiplier: {
			Tooltip: Умножает базовую стоимость всех товаров в ассортименте у Находчика на этот коэффициент (от 0.1 до 10).
			Label: Коэффициент стоимости товаров
		}

		DaylightProductionSpeed: {
			Label: Station Essence Production Speed
			Tooltip: Multiplier for essence production speed in Daylight Generator and Daylight Station (from 0.8 to 2.25).
		}

		DaylightCapacityMultiplier: {
			Label: Station Essence Capacity
			Tooltip: Multiplier for maximum essence capacity in Daylight Generator and Daylight Station (from 1 to 10).
		}

		EssenceDropMultiplier: {
			Label: Essence Drop Rate Multiplier
			Tooltip: Multiplier for essence drop chance and amount from enemies and bosses (from 0.5 to 7.5).
		}

		TrailQuality: {
			Tooltip: Количество подточек Catmull-Rom интерполяции процедурных шлейфов VertexStrip. Меньшие значения повышают FPS на слабых ПК, большие значения дают наиболее гладкие изгибы.
			Label: Качество интерполяции шлейфов / Trail Quality (Spline Subdivisions)
		}

		DisableAnimatedEssenceSections: {
			Label: Отключить живые секции эссенции / Disable Animated Essence Sections
			Tooltip: При включении секции полосок эссенции в интерфейсах становятся статичными квадратными блоками без волнообразной анимации.
		}

		EnableSomeShaders: {
			Label: Enable Some Shaders
			Tooltip: Включение шейдера портала у крюка PortalHook / Enable portal shader for PortalHook
		}

		EnableBuffNPCVisual: {
			Label: Enable Buff N P C Visual
			Tooltip: ""
		}

		EnableAccessoryCooldownUI: {
			Label: Панель кулдаунов аксессуаров
			Tooltip: Позволяет включить или отключить верхнюю панель кулдаунов аксессуаров на экране
		}

		ShowEssencePickupText: {
			Label: Текст подбора эссенций
			Tooltip: Позволяет включить или отключить всплывающие надписи подбираемых эссенций над игроком
		}

		AlwaysGrowHerbs: {
			Label: Универсальный рост цветов для зелий
			Tooltip: Позволяет всем наземным цветам для зелий (днецвет, лунноцвет, мерцающий корень, смертоцвет, воднолист, огнецвет, ледошип) расти и цвести в любом биоме, в любое время и на любой поверхности без каких-либо ограничений.
		}

		AutoRejoinTeam: {
			Label: Автоматическое подключение к команде
			Tooltip: Если включено, игрок при заходе в мир автоматически заходит в ту команду, в которой находился до этого. Если игрок не состоял в команде, ничего не произойдёт.
		}

		FastExtractinator: {
			Label: Быстрая переработка на Обогатителе (x10)
			Tooltip: Ускоряет переработку блоков на Обогатителе (Extractinator) в 10 раз.
		}

		ExtractStackInstantly: {
			Label: Мгновенная переработка всего стака на Обогатителе
			Tooltip: При ПКМ по Обогатителю перерабатывается сразу весь стак блоков в руках.
		}

		EnableScreenFlashes: {
			Tooltip: Позволяет включить или отключить вспышку экрана при заходе и выходе из интерфейсов, таких как стол исследований
			Label: Вспышки экрана
		}

		EnableHoverEssencePanel: {
			Label: Enable Essence Pop-up Panel
			Tooltip: Enables or disables the essence pop-up panel when hovering over the research station
		}

		EnableGoblinReforge: {
			Label: Enable New Goblin Reforge System
			Tooltip: When enabled, uses the new attribute selection system for Goblin Tinkerer reforging. When disabled, restores vanilla reforging.
		}
	}
}

