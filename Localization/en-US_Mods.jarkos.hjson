	}

	HeavenlyBottle: {
		Tooltip:
			'''
			Increases magic damage by 8%
			Reduces mana consumption by 15%
			When taking damage, it restores mana from half of the damage received.
			Recharge time is 20 seconds
			'''
		DisplayName: Heavenly Bottle
	}

	GauntletOfMage: {
		Tooltip:
			'''
			Increases Magic attack speed by 2%
			Increases the speed of magic projectiles by 10%
			'''
		DisplayName: Gauntlet Of Mage
	}

	EyeOfMage: {
		Tooltip:
			'''
			Increases magic damage depending on the missing mana
			If the missing mana is greater than the current one, the "Vulnerability" debuff is applied to the target, which increases the damage received by the target.
			'''
		DisplayName: Eye Of Mage
	}

	VoronWings: {
		Tooltip: Allows you to fly, albeit for a short time
		DisplayName: Voron Wings
	}

	UnstableBlade: {
		Tooltip:
			'''
			25 Base Damage
			Summons a blade of instability that is ready to protect you until death.
			It has 3 attack phases, with the last one dealing 30% more damage.
			'''
		DisplayName: Unstable Blade
	}

	SealOfShadow: {
		Tooltip:
			'''
			Depending on the player's movement speed, pulsations emanate from the player.
			which deal damage to the closest enemies and apply a debuff "Under the shadow".
			The debuff enhances the attack on enemies, as well as slows them down.
			'''
		DisplayName: Seal Of Shadow
	}

	HeartOfSerenity: {
		Tooltip:
			'''
			Increases attack speed by 5%
			Increases movement speed after taking damage
			Reduces the aggressiveness of enemies on you
			'''
		DisplayName: Heart Of Serenity
	}

	GoldenLens: {
		Tooltip:
			'''
			Increases total damage by 5%
			Increases maximum health and Mana by 50
			'''
		DisplayName: Golden Lens
	}

	EffluxCrystal: {
		Tooltip:
			'''
			Increases total damage by 5%
			Increases the effectiveness of healing potions by 75%
			Increases maximum health by 5 for each armor unit
			Significantly enhances health regeneration 
			Each attack can restore health by 1-3 units with a chance of 8%.
			During the blood moon, the user becomes stronger
			[c/EF6455:The effects cannot be combined with:]
			[i:jarkos/BleedingMoonAmulet] [c/EFA255:Bleeding Moon Amulet]
			[i:jarkos/DistortedStone] [c/EFA255:Distorted Stone]
			'''
		DisplayName: Efflux Crystal
	}

	DistortedStone: {
		Tooltip:
			'''
			Increases the effectiveness of healing potions by 50%
			Increases maximum health by 150 points 
			And regeneration of health from 3 to 9 units, depending on the depth at which the user is located.
			[c/EF6455:The effects cannot be combined with:]
			[i:jarkos/EffluxCrystal] [c/EFA255:Efflux Crystal]
			'''
		DisplayName: Distorted Stone
	}

	CoreOfTrouble: {
		Tooltip: The core increases mana regeneration depending on the player's missing health.
		DisplayName: Core Of Trouble
	}

	ClockWithTimer: {
		Tooltip:
			'''
			If the next attack on the owner is fatal, it will instantly restore 20% of the player
			health, as well as accelerate the regeneration of health for 7 seconds,
			After that, the timer clock is charged and can no longer be reused.
			'''
		DisplayName: Clock With Timer
	}

	BleedingMoonAmulet: {
		Tooltip:
			'''
			Increases total damage by 4% and another 6% during the blood moon.
			Reduces maximum health by 2%.
			Each attack can trigger an explosion of blood energy, which can restore some of the user's health.
			[c/EF6455:The effects cannot be combined with:]
			[i:jarkos/EffluxCrystal] [c/EFA255:Efflux Crystal]
			'''
		DisplayName: Bleeding Moon Amulet
	}

	BiomaterialConverter: {
		Tooltip:
			'''
			Every 5 seconds, heals 1% of maximum health.
			If any boss is alive, the healing happens 3 times less frequently.
			'''
		DisplayName: Biomaterial Converter
	}

	ArcaneFlower: {
		Tooltip:
			'''
			Increases health regeneration depending on the wearer's movement speed.
			At high speeds, health regeneration reaches 15 HP/sec.
			'''
		DisplayName: Arcane Flower
	}

	ProtectiveStone: {
		Tooltip: Increases the player's protection depending on the missing health.
		DisplayName: Protective Stone
	}

	OtherworldlyPlea: {
		Tooltip:
			'''
			Increases the user's protection depending on the missing health.
			If health is below 50%, it grants 20% damage resistance.

			[c/EF6455:The effects cannot be combined with:]
			[i:jarkos/ProtectiveStone] [c/EFA255:Protective Stone]
			[i:3224] [c/EFA255:Scarf Worm]
			'''
		DisplayName: Otherworldly Plea
	}

	SmolderingLotus: {
		Tooltip:
			'''
			When click on "bind" drains mana from nearby enemies.
			The owner becomes stronger after receiving someone else's mana, albeit temporarily.
			Cooldown is 30 seconds.
			'''
		DisplayName: Smoldering Lotus
	}

	BranchOfMadness: {
		DisplayName: Branch Of Madness
		Tooltip:
			'''
			Increases the chance of a critical hit by 25%
			Significantly increases the frequency of enemy spawn
			"Calmness is the main trait of a warrior."
			'''
	}

	HollowManaCharm: {
		DisplayName: Hollow Mana Charm
		Tooltip:
			'''
			"Absolutely without any engraving."
			Increases mana consumption by 10%, but in return increases mana regeneration rate by 30%.
			'''
	}

	MedallionOfMalice: {
		DisplayName: Medallion Of Malice
		Tooltip:
			'''
			Slightly increases the frequency of enemy appearances
			Reduces protection by 5
			"Your ass is burning up, isn't it?"
			'''
	}

	BiomechanicalHeart: {
		DisplayName: Biomechanical Heart
		Tooltip:
			'''
			It is triggered if the wearer's current health is below 75%,
			Attacks nearby enemies and sucks blood from them.
			The heart pours all the accumulated blood out of itself into the player, and at the same time heals him.
			The heart will disappear as soon as the player has more than 75% health.
			'''
	}

	BloodImpulse: {
		DisplayName: Blood Impulse
		Tooltip:
			'''
			Pressing the "bind" key, releases a bloody splash, which deals heavy damage and poisons the target for 15 seconds.
			Recharge time is 60 seconds.
			'''
	}

	EmblemOfMisery: {
		DisplayName: Emblem Of Misery
		Tooltip:
			'''
			Increases the damage received by 25%, but in return increases the damage dealt by 125%.
			Increases attack speed by 10%
			Reduces defense by half
			Reduces health regeneration by 2
			'''
	}

