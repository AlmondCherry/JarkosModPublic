}

Runes: {
	filth_rune_desc:
		'''
		[c/E9B5FF: The rune of filth is activated]

		Teleports the player to the cursor position when pressed
		'''
	steampunk_rune_desc:
		'''
		[c/FFF8B5: The rune of steampunk is activated]

		Increases the damage of a mechanoid weapon, when receiving damage, part of the energy is restored
		'''
	elder_rune_desc:
		'''
		[c/B5CBFF: The rune of the past is activated]

		when player receiving damage, create a shield that protects against 25% damage for 3 seconds
		'''
	flame_rune_desc:
		'''
		[c/FFE4B5: The rune of the flame is activated]

		when player receiving damage, there is a chance to set fire burst a short distance away.
		'''
}

BuffDesc.filth_disease_desc: You're sick with filth, stage:
MonitormiseryDesc.core_of_trouble_desc: Mods.jarkos.MonitormiseryDesc.core_of_trouble_desc

LoreTooltips: {
	hint_text: "[c/AFAFAF:Press] Shift, [c/AFAFAF:to see more details]"
	eom_text:
		'''
		[c/AFAFAF:This eye once belonged to the greatest magician in the dungeon...]
		[c/AFAFAF:He knew a lot about magic, if not everything that was possible to know...]
		[c/AFAFAF:And only the user has the right to control the power of this artifact.]
		[c/AFAFAF:Never trust anyone but your own feelings, they will never let you down.]
		'''
	burning_label_text:
		'''
		[c/AFAFAF:In the era when the underground cradle still existed, this mark was fixed on the nobodies of that time.]
		[c/AFAFAF:These are different times, but she can still be useful.]
		'''
	ancient_flower_text:
		'''
		[c/AFAFAF:It is a memorable relic of the underground cradle, once upon a time there was vegetation there.]
		[c/AFAFAF:The ancient flower blooms very quickly, and absurdly, it also closes quickly.]
		'''
	anxiety_text:
		'''
		[c/AFAFAF:Fear empties your senses, but at the same time you become overly self-centered.]
		[c/AFAFAF:She used to worry about human problems, too.]
		'''
	magical_glove_text:
		'''
		[c/AFAFAF:The unfinished prototype of Celestia's invention. It was supposed to protect its owner from overuse of mana.]
		[c/AFAFAF:So far, none of the owners, except for Celestia herself, has understood the mechanism of operation of this glove.]
		'''
	magical_earring_text:
		'''
		[c/AFAFAF:Trinkets and fun of the past years...]
		[c/AFAFAF:She may have magical powers, but at least they are imperceptible.]
		'''
	moon_dawn_text:
		'''
		[c/AFAFAF:The only copy of this artifact that belonged to Celestia is now in your hands.]
		[c/AFAFAF:Maybe it's worth feeling the real power?]
		'''
	heart_of_serenity:
		'''
		[c/AFAFAF:The heart is still alive, calmness is the way to overcome obstacles.]
		[c/AFAFAF:It contains parts of the souls of the inhabitants of the underground cradle.]
		'''
	dark_peddler_text:
		'''
		[c/AFAFAF:Let every blow of this axe be a cry of rage.]
		[c/AFAFAF:May he bring not death, but a curse.]
		'''
	true_peddler_text:
		'''
		[c/AFAFAF:The axe has already felt your blood.]
		[c/AFAFAF:Let it flow... This is the only way to defeat them...]
		'''
}

