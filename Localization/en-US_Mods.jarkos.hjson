Items: {
	AlphaRuneItem: {
		DisplayName: Alpha Rune
		Tooltip: Holds up to 100,000 essence and stores up to 8 different essence types
	}

	TetraRuneItem: {
		DisplayName: Tetra Rune
		Tooltip: Holds up to 1,000,000 essence and stores up to 16 different essence types
	}

	LiftingPlateItem: {
		DisplayName: Lifting Plate
		Tooltip:
			'''
			Lifts the player upwards after a 0.15s delay when stepped on
			Causes smooth levitation while falling back down
			'''
	}

	RuneEnchantmentScroll: {
		DisplayName: Rune Enchantment Scroll
		Tooltip:
			'''
			While in inventory, guarantees 100% success chance for rune enchanting at Rune Altar
			Consumed upon enchanting
			'''
	}

	TightGripHook: {
		DisplayName: Tight Grip Hook
		Tooltip:
			'''
			Latches onto enemies and blocks
			Holds player at a fixed distance and shortens the rope when the enemy gets closer
			'''
	}

	EssenceJarItem: {
		DisplayName: Essence Jar
		Tooltip:
			'''
			Shatters on impact and releases orbs of researched essences
			Releases 2 to 6 types of essences (5 to 20 orbs in total)
			'''
	}

	EtherTinctureItem: {
		DisplayName: Ether Tincture
		Tooltip: Increases essence drop chance from enemies by 2.5x
	}

	MidasPotionItem: {
		DisplayName: Midas Potion
		Tooltip: Increases coins dropped from slain monsters by 150%
	}

	ReplicatorItem: {
		DisplayName: Replicator
		Tooltip:
			'''
			Clones item from input slot into 2 copies in output slots
			Requires 75 Chitinus essences in stored bar
			Cloning process takes 140 seconds
			Essences are transferred via Spreader beams
			'''
	}

	ManaPlateItem: {
		DisplayName: Mana Plate
		Tooltip:
			'''
			Standing on the plate restores 20 mana every second
			During boss fights, the plate works 3 times slower
			'''
	}

	HealthPlateItem: {
		DisplayName: Health Plate
		Tooltip:
			'''
			Standing on the plate grants +10 health regeneration and +75% total regen efficiency
			During boss fights, bonuses are reduced by 50%
			'''
	}

	CoolingFuel: {
		DisplayName: Cooling Fuel
		Tooltip:
			'''
			Speeds up essence production in Daylight Station by 20%
			Consumes 1 item every 5 seconds when placed in station slot
			'''
	}

	SpectralFuel: {
		DisplayName: Spectral Fuel
		Tooltip:
			'''
			Speeds up essence production in Daylight Station by 70%
			Consumes 1 item every 5 seconds when placed in station slot
			'''
	}

	DaylightStationItem: {
		DisplayName: Daylight Station
		Tooltip:
			'''
			Generates 1 essence researched by server host/player every 30 seconds
			Works only during daytime and above caverns layer
			Holds up to 250 essences
			Contains 2 booster fuel slots
			Only one station can exist in the world!
			'''
	}

	DaylightGeneratorItem: {
		DisplayName: Daylight Generator
		Tooltip:
			'''
			Generates 1 basic essence every 30 seconds
			Works only during daytime and above caverns layer
			Holds up to 75 essences
			Right-click to open collection interface
			'''
	}

	LightHook: {
		DisplayName: Light Hook
		Tooltip:
			'''
			Emits bright light and highlights all ores within a 500 radius
			Holds the player to the block until pressing the hook key (E) again
			'''
	}

	GalvanicHook: {
		DisplayName: Galvanic Hook
		Tooltip:
			'''
			Emits an electric explosion upon hitting a block
			Knocks back enemies and slows them by 30% for 1 second without dealing damage
			'''
	}

	FeatherHook: {
		DisplayName: Feather Hook
		Tooltip:
