	}

	NatureSingularity: {
		Tooltip:
			'''
			"There's definitely something wrong here.
			"The world has never been so evil and sinful.
			"But you won't be as evil, right?"
			"Protect this land, Decider."

			Slightly reduces the frequency of enemy appearances
			Increases Summoning damage by 5%
			Increases the maximum number of minions by 2
			For each summoned minion, the damage received is reduced by 1%
			'''
		DisplayName: Nature Singularity
	}

	GalaxyPearl: {
		Tooltip:
			'''
			Hits on enemies grant the "Summon Power Amplification" buff
			Each hit increases summon damage by 1% (up to 20% max)
