	}

	RadiantGenerator: {
		Tooltip:
			'''
			Увеличивает призывной урон на 12%
			Увеличивает максимальное количество миньонов на 2
			При ударе накладывает на врага дебафф "Кровотечение" и "Наэлектризован"
