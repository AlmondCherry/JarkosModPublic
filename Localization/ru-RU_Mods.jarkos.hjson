	Turgravir: {
		DisplayName: Турбогравир
		Tooltip: С небольшим шансом выстреливает пробивающим снарядом
	}

	Twobarrel_atomgun: {
		DisplayName: Двухствольная атомная пушка
		// Tooltip: ""
