Items: {
	AlphaRuneItem: {
		DisplayName: Альфа-руна
		Tooltip: Вмещает до 100,000 эссенции и хранит до 8 разных видов эссенции
	}

	TetraRuneItem: {
		DisplayName: Тетра-руна
		Tooltip: Вмещает до 1,000,000 эссенции и хранит до 16 разных видов эссенции
	}

	LiftingPlateItem: {
		DisplayName: Поднимающая плита
		Tooltip:
			'''
			Поднимает игрока вверх через 0.15 секунд после наступания
			После взлёта игрок плавно левитирует при падении
			'''
	}

	RuneEnchantmentScroll: {
		DisplayName: Свиток рунного зачарования
		Tooltip:
			'''
			Находясь в инвентаре, гарантирует 100% шанс успеха зачарования на Рунном Алтаре
			Расходуется при проведении зачарования
			'''
	}

	TightGripHook: {
		DisplayName: Крюк с крепким хватом
		Tooltip:
			'''
			Цепляется за врагов и блоки
			Удерживает игрока на расстоянии и сужает тросик, если враг поджимает расстояние
			'''
	}

	EssenceJarItem: {
		DisplayName: Банка с эссенциями
		Tooltip:
			'''
			Разбивается при столкновении и высвобождает орбы исследованных эссенций
			Высвобождает от 2 до 6 видов эссенций (всего от 5 до 20 штук)
			'''
	}

	EtherTinctureItem: {
		DisplayName: Эфирная настойка
		Tooltip: Увеличивает шанс выпадения эссенций с врагов в 2.5 раза
	}

	MidasPotionItem: {
		DisplayName: Зелье Мидаса
		Tooltip: Увеличивает количество монет с убитых монстров на 150%
	}

	ReplicatorItem: {
		DisplayName: Репликатор
		Tooltip:
			'''
			Клонирует предмет из входного слота в 2 копии в выходных слотах
			Требует 75 эссенций Chitinus в хранимой шкале
			Процесс клонирования занимает 140 секунд
			Эссенции передаются лучами Распространителя
			'''
	}

	ManaPlateItem: {
		DisplayName: Плита маны
		Tooltip:
			'''
			Стоя на плите, игрок восстанавливает по 20 маны каждую секунду
			Во время битвы с боссом плита работает в 3 раза медленнее
			'''
	}

	HealthPlateItem: {
		DisplayName: Плита здоровья
		Tooltip:
			'''
			Стоя на плите, игрок получает +10 к регенерации здоровья и +75% к общей эффективности регенерации
			Во время битвы с боссом бонусы уменьшаются на 50%
			'''
	}

	CoolingFuel: {
		DisplayName: Охлаждающее топливо
		Tooltip:
			'''
			Ускоряет производство эссенций в Дневной станции на 20%
			Расход по 1 шт. каждые 5 секунд при помещении в слот станции
			'''
	}

	SpectralFuel: {
		DisplayName: Спектральное топливо
		Tooltip:
			'''
			Ускоряет производство эссенций в Дневной станции на 70%
			Расход по 1 шт. каждые 5 секунд при помещении в слот станции
			'''
	}

	DaylightStationItem: {
		DisplayName: Дневная станция
		Tooltip:
			'''
			Генерирует 1 исследованную хостом/игроком эссенцию каждые 30 секунд
			Работает только днём и выше слоя пещер
			Вмещает до 250 эссенций
			Содержит 2 слота для разгона топлива
			В мире может стоять только одна станция!
			'''
	}

	DaylightGeneratorItem: {
		DisplayName: Дневной генератор
		Tooltip:
			'''
			Генерирует 1 базовую эссенцию каждые 30 секунд
			Работает только днём и выше слоя пещер
			Вмещает до 75 эссенций
			Нажмите ПКМ, чтобы открыть интерфейс сбора
			'''
	}

	LightHook: {
		DisplayName: Световой крюк
		Tooltip:
			'''
			Излучает яркий свет и подсвечивает все руды в радиусе 500
			Удерживает игрока на блоке до повторного нажатия клавиши крюка (E)
			'''
	}

	GalvanicHook: {
		DisplayName: Гальванический крюк
		Tooltip:
			'''
			При попадании в блок вызывает электрический взрыв
			Взрыв отталкивает врагов и замедляет их на 30% на 1 секунду без урона
			'''
	}

	FeatherHook: {
		DisplayName: Перьевой крюк
		Tooltip:
			'''
			Выпускает крюк на большую дистанцию
			Отсоединяется на половине пути, ускоряя игрока по направлению рывка
			'''
	}

