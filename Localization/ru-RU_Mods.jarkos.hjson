		Tooltip:
			'''
			Увеличивает урон в ближнем бою на 4%
			Увеличивает скорость атаки в ближнем бою на 2%
			Увеличивает максимальное ОЗ на 15
			Даёт возможность делать слабый рывок
			'''
		DisplayName: Деревянный щит
	}

	TheDawnMoon: {
		Tooltip:
			'''
