	Ultimatum: {
		DisplayName: Ультиматум
		Tooltip: Иногда может совершить тройной выстрел
	}

	Angelic_staff: {
		DisplayName: Ангельский посох
		Tooltip:
			'''
			Призывает ангела, который атакует врага разными способами
			Использует 2 слота миньона
			'''
	}

	Antique_totem: {
		DisplayName: Антикварный тотем
		Tooltip: Призывает антикварный тотем, который вместе с другими тотемами концетрируется на одной цели
	}

	Astralrift_staff: {
		DisplayName: Посох астрального разлома
		Tooltip: Призывает астральный разлом который обстреливает врага чаще в зависимости от максимальной маны владельца
	}

	Plague_staff: {
		DisplayName: Чумной посох
		Tooltip: Призывает ворона, который атакует врага пробивая насквозь
	}

	Static_crystal_staff: {
		DisplayName: Посох Статичного осколка
		Tooltip:
			'''
			Осколки соединяются друг с другом, образуя сеть
			И чем больше сеть, тем больший урон получает цель
			'''
	}

	Truthfulknight_staff: {
		DisplayName: Посох Правдивого рыцаря
		Tooltip:
			'''
			В обычном режиме рыцари рассекают цель расскручиваясь
			На зажатый ПКМ каждый рыцарь дает вам +2 к броне и +1 к регенерации здоровья, но при этом расходуется мана
			'''
	}

	Vigilante_staff: {
		DisplayName: Посох Линчевателя
		Tooltip: Призывает линчевателя, который обстреливает врагов вблизи
	}

	Ancient_whip: {
		DisplayName: Древний кнут Бога природы
		Tooltip: Можно вложить дополнительную силу в удар, зажав ЛКМ
	}

	Antique_whip: {
		DisplayName: Антикварный кнут
		Tooltip: В зависимости от расстояния при попадании создаёт взрывную силу
	}

	Arterial_whip: {
		DisplayName: Артериальный кнут
		Tooltip:
