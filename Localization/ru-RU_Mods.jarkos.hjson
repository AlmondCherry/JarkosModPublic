	NatureSingularity: {
		Tooltip:
			'''
			"Здесь определённо что-то не то."
			"Мир никогда не был настолько злым и грешным."
			"Но ведь ты не будешь таким-же злым, верно?"
			"Защити эту землю, Вершитель."

			Немного уменьшает частоту появления врагов
			Увеличивает урон призывателя на 5%
			Увеличивает максимальное количество миньонов на 2

			При попадании по врагу увеличивает призывной урон на 1% (до 20% максимум)
			Если в течение 5 секунд по врагу больше не попадали, бонус спадает за 1 секунду

			За каждого призванного миньона, уменьшается получаемый урон на 1%
			'''
		DisplayName: Природная сингулярность
	}

	GalaxyPearl: {
		Tooltip:
			'''
			При попадании по врагу даёт бафф "Усиление призывной силы"
			Каждый удар увеличивает призывной урон на 1% (до 20% максимум)
			При прекращении атаки бафф сохраняется на 5 секунд
