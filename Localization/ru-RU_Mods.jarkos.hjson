Runes: {
	filth_rune_desc:
		'''
		[c/E9B5FF: Повреждённое крыло активировано]

		Вы не можете летать.
		'''
	steampunk_rune_desc:
		'''
		[c/FFF8B5: Проклятая монетка активирована]

		Чем больше денег в слотах для монет, тем мощнее вы становитесь.
		Количество выпадаемых монет с существ значительно снижено.
		Ваша удача значительно снижена.
		'''
	elder_rune_desc:
		'''
		[c/FFF8B5: Монитор страданий активирован]

		Защита и сопротивление к урону отключено.
		Здоровье зафиксировано на 1 единице.
		Вы удостоены более щедрой награды.
		Впрочем, ваш урон увеличен вдвое.
		Некоторые акссесуары переосмыслят свою полезность.
		'''
	flame_rune_desc:
		'''
		[c/FFE4B5: Сломанное стёклышко активировано]

		Ваш урон и скорость атаки увеличены вдвое.
		Максимальное здоровье снижено вдвое.
		Вы лишены защиты.
		С течением времени, вы получаете дебафф "кровотечение"
		'''
}

// BuffDesc.filth_disease_desc: You're sick with filth, stage:
MonitormiseryDesc.core_of_trouble_desc:
	'''
	?????
	Недостающая мана дарует больше сил.
	'''

LoreTooltips: {
	hint_text: "[c/AFAFAF:Нажмите] Shift, [c/AFAFAF:чтобы увидеть подробности]"
	eom_text:
		'''
		[c/AFAFAF:Когда-то этот глаз принадлежал величайшему магу подземелья...]
		[c/AFAFAF:Он знал о магии очень многое, если конечно не всё, что возможно знать...]
		[c/AFAFAF:И только пользователь в праве распоряжаться силой этого артефакта.]
		[c/AFAFAF:Никогда не верь никому, кроме собственных чувств, они никогда не подведут тебя.]
		'''
	burning_label_text:
		'''
		[c/AFAFAF:Кто-то, кто знал как обращаться с магией крови по всей видимости понимал,]
		[c/AFAFAF:что её потенциал безграничен. Безграничен также как и сейчас.]
		'''
	ancient_flower_text:
		'''
		[c/AFAFAF:Является памятной реликвией о подземной колыбели, когда-то давно там была растительность.]
		[c/AFAFAF:Древний цветок очень быстро расцветает, и что абсурдно также быстро закрывается.]
		'''
	anxiety_text:
		'''
		[c/AFAFAF:Страх опустошает ваши чувства, но при этом вы становитесь чрезмерно эгоцентричным.]
		[c/AFAFAF:Когда-то и она беспокоилась о человеческих проблемах.]
		'''
	magical_glove_text:
		'''
		[c/AFAFAF:Незавершённый прототип изобретения Селестии. Он должен был оберегать своего владельца от чрезмерного использования маны.]
		[c/AFAFAF:До сих пор ни одному из владельцев, кроме самой Селестии, непонятен механизм работы данной перчатки.]
		'''
	magical_earring_text:
		'''
		[c/AFAFAF:Побрякушка и забава прошлых лет...]
		[c/AFAFAF:Возможно она и даёт магические силы, но по крайней мере неощутимые.]
		'''
	moon_dawn_text:
		'''
		[c/AFAFAF:Единственный экземпляр этого артефакта, который принадлежал Селестии, теперь у вас в руках.]
		[c/AFAFAF:Возможно стоит прочувствовать настоящую силу?]
		'''
	heart_of_serenity:
		'''
		[c/AFAFAF:Сердце всё ещё живёт, спокойствие - путь преодоления препятствий.]
		[c/AFAFAF:Содержит части душ жителей подземной колыбели.]
		'''
	dark_peddler_text:
		'''
		[c/AFAFAF:Пусть каждый удар этого топора будет воплем ярости. ]
		[c/AFAFAF:Пусть он будет нести не смерть, а проклятие.]
		'''
	true_peddler_text:
		'''
		[c/AFAFAF:Топор уже почувствовал твою кровь.]
		[c/AFAFAF:Пусть она льётся... Только так возможно победить их...]
		'''
}

