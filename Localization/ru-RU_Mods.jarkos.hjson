			Очень быстро стреляет водными пулями, которые наводятся на врагов
			Также иногда оружие выпускает большие пузыри, которые наносят небольшой урон
			'''
	}

	Laser_one: {
		DisplayName: Лазерная пушка Mk. I
		Tooltip: ""
	}

	Laser_two: {
		DisplayName: Лазерная пушка Mk. II
		Tooltip: ""
	}

	Liquid_magma: {
		DisplayName: Жидкая магма
		Tooltip: Стреляет каплями жидкой магмы, которая поджигает врагов
	}

	M_blaster: {
		DisplayName: Мезонный бластер
		Tooltip:
			'''
			Стреляет мезонными снарядами, которые при попадании взрываются
			либо на 4 луча, либо просто на небольшую ударную волну
			'''
	}

	Magellonova: {
		DisplayName: Магеллоновая
		Tooltip:
			'''
			Выстреливает очень мощным космическим боезапасом, распадаясь на малые энергетические сферы
			Малые энергосферы делятся и стреляют своей отделённой частью во врага, после чего полностью исчезают
			'''
	}

	Nailgun01: {
		DisplayName: Гвоздемёт
		Tooltip:
			'''
			Стреляет очередью из трёх заряженных гвоздей
			Враг взрывается, если по нему попадёт все 3 гвоздя из очереди
			'''
	}

	Nova: {
		DisplayName: Новая
		Tooltip: Стреляет энергетическим снарядом, при попадании создаёт самоделящееся энергетическую сферу, которая испускает малые частички себя
	}

	Particle_acc: {
		DisplayName: Ускоритель частиц
		Tooltip:
			'''
			Стреляет быстрыми частицами
			Иногда выстреливает пробивающей частицей, которая пробивает всех врагов на пути
			'''
	}

	Piercer: {
		DisplayName: Пробойник
		Tooltip:
			'''
			Выстреливает очередью из 3 энергетических пуль
			На ПКМ прокручивается пистолет, и выстреливает мощным плазменным снарядом, который взрывается при попадании
			'''
	}

	Pistol_annoyance: {
		DisplayName: Пистолет кровожадного
		Tooltip: При попадании взаимствует часть здоровья врага, владельцу
	}

	Plague_slimemachine: {
		DisplayName: Пушка тёмной слизи
		Tooltip: Выстреливает увеличивающейся тёмной слизью, которая разрывается на маленькие капли
	}

	Plasma_wave: {
		DisplayName: Плазменно-волновая винтовка
		Tooltip: Стреляет волновой плазмой, при попадании оставляет взрывную волну
	}

	Reflector: {
		DisplayName: Отражатель
		Tooltip: Становится сильнее после каждого рикошета
	}

	Rollback: {
		DisplayName: Пушка Отката
		Tooltip:
			'''
			На ПКМ создаёт энергетические сферы
			На ЛКМ выстреливает лазером, попадая по сфере, наносится большой урон по области
			'''
	}

	Scarlet_traveler: {
		DisplayName: Алый путеводитель
		Tooltip: Стреляет расщепляющимся на малые части, снарядом
	}

	Sniper_horseman: {
		DisplayName: Винтовка Всадника
