	}

	EffluxCrystal: {
		Tooltip:
			'''
			Увеличивает общий урон на 5%
			Увеличивает эффективность лечебных зелий на 75%
			Увеличивает максимальное здоровье на 5 за каждую единицу брони
			Значительно усиливает регенерацию здоровья 
			Каждая атака может с шансом в 8% восстановить здоровье на 1-3 единицы
